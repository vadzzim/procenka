# Copy to .env and adjust if needed. All values below are the defaults.
# docker compose reads .env automatically; pytest does not. To use these values in
# tests, export TEST_DATABASE_URL in the shell or run from the repository root:
#   uv run --directory backend --env-file ../.env pytest

# PostgreSQL container (deploy/compose.yaml)
POSTGRES_USER=procenka
POSTGRES_PASSWORD=procenka
POSTGRES_DB=procenka
POSTGRES_HOST_PORT=54329

# Application, alembic, seed and reset (read from the process environment, not from .env).
DATABASE_URL=postgresql+asyncpg://procenka:procenka@localhost:54329/procenka

# Integration tests connect here; the `procenka_test` database is created on demand.
# Keep host port and credentials in sync with the values above.
TEST_DATABASE_URL=postgresql+asyncpg://procenka:procenka@localhost:54329/procenka_test
