{
  "openapi": "3.1.0",
  "info": {
    "title": "Проценка",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Живо ли приложение: база данных отвечает на ``SELECT 1``.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "База данных не отвечает",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Create Run",
        "description": "Поставить ручной прогон в очередь; если прогон уже есть — вернуть существующий.",
        "operationId": "create_run_api_runs_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCreated"
                }
              }
            }
          },
          "200": {
            "description": "Прогон уже идёт или ждёт запуска",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "description": "Статус прогона и результаты источников.",
        "operationId": "get_run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/published-prices": {
      "get": {
        "summary": "Published Prices",
        "description": "Только опубликованные цены; рекомендации из карантина сюда не попадают.",
        "operationId": "published_prices_api_published_prices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedPricesOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Get Status",
        "description": "Последний и активный прогон; источники последнего завершённого прогона.",
        "operationId": "get_status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Get Products",
        "description": "Таблица товаров: закупка, опубликованная цена и последний расчёт.\n\nПоследний расчёт берётся только из прогонов succeeded и partial.",
        "operationId": "get_products_api_products_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/calculations/{calculation_id}": {
      "get": {
        "summary": "Get Calculation",
        "description": "«Почему цена такая»: вход, предложения, границы, ограничения, решение и формула.",
        "operationId": "get_calculation_api_calculations__calculation_id__get",
        "parameters": [
          {
            "name": "calculation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Calculation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculationOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/calculations/{calculation_id}/confirm": {
      "post": {
        "summary": "Confirm",
        "description": "Подтвердить рекомендацию из карантина и опубликовать её.\n\nМожно только рекомендацию последнего завершённого прогона, не старше\nдопустимого возраста, если закупка, версия правил, настройки товара и\nопубликованная цена не изменились с момента расчёта. Проверка и запись —\nв одной транзакции.",
        "operationId": "confirm_api_calculations__calculation_id__confirm_post",
        "parameters": [
          {
            "name": "calculation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Calculation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedPriceOut"
                }
              }
            }
          },
          "404": {
            "description": "Расчёт не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Подтвердить нельзя: код и причина; ничего не опубликовано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmRefusalOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/modes": {
      "get": {
        "summary": "Get Modes",
        "description": "Текущий режим каждого источника.",
        "operationId": "get_modes_api_demo_modes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoModesOut"
                }
              }
            }
          },
          "502": {
            "description": "fake-sites недоступен или ответил ошибкой",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/modes/{source}": {
      "put": {
        "summary": "Put Mode",
        "description": "Переключить режим источника; действует со следующего запроса парсера.",
        "operationId": "put_mode_api_demo_modes__source__put",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Source"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModeChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceModeOut"
                }
              }
            }
          },
          "502": {
            "description": "fake-sites недоступен или ответил ошибкой",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/reset": {
      "post": {
        "summary": "Reset Demo",
        "description": "Вернуть демо в исходное состояние: оба источника — normal, БД — как после seed.\n\nПорядок: проверка активного прогона → сброс режимов fake-sites → в одной\nтранзакции под блокировкой ``runs`` повторная проверка и сброс БД. Режимы\nсбрасываются первыми, поэтому прогон, поставленный во время сброса, либо\nстирается сбросом БД, либо (если он ещё в очереди или выполняется) даёт 409,\nно никогда не выполняется со старыми режимами после ответа 200.",
        "operationId": "reset_demo_api_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoResetOut"
                }
              }
            }
          },
          "409": {
            "description": "Есть прогон в очереди или в работе",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "fake-sites недоступен или ответил ошибкой",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalculationInputsOut": {
        "properties": {
          "purchase_price": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "title": "Purchase Price",
            "examples": [
              "1240.00"
            ]
          },
          "min_markup_percent": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "title": "Min Markup Percent",
            "examples": [
              "-25.1"
            ]
          },
          "step": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "title": "Step",
            "examples": [
              "1240.00"
            ]
          },
          "ceiling": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Ceiling"
          },
          "quarantine_threshold_percent": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "title": "Quarantine Threshold Percent",
            "examples": [
              "-25.1"
            ]
          },
          "suspicious_price_factor": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "title": "Suspicious Price Factor",
            "examples": [
              "-25.1"
            ]
          },
          "max_delivery_days": {
            "type": "integer",
            "title": "Max Delivery Days"
          }
        },
        "type": "object",
        "required": [
          "purchase_price",
          "min_markup_percent",
          "step",
          "ceiling",
          "quarantine_threshold_percent",
          "suspicious_price_factor",
          "max_delivery_days"
        ],
        "title": "CalculationInputsOut",
        "description": "Purchase and settings as they were at the time of the calculation."
      },
      "CalculationOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "run_id": {
            "type": "integer",
            "title": "Run Id"
          },
          "run_status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "product": {
            "$ref": "#/components/schemas/ProductOut"
          },
          "calculated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Calculated At"
          },
          "rules_version": {
            "type": "string",
            "title": "Rules Version"
          },
          "partial_data": {
            "type": "boolean",
            "title": "Partial Data"
          },
          "inputs": {
            "$ref": "#/components/schemas/CalculationInputsOut"
          },
          "accepted_offers": {
            "items": {
              "$ref": "#/components/schemas/OfferOut"
            },
            "type": "array",
            "title": "Accepted Offers"
          },
          "rejected_offers": {
            "items": {
              "$ref": "#/components/schemas/RejectedOfferOut"
            },
            "type": "array",
            "title": "Rejected Offers"
          },
          "min_competitor_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Competitor Price"
          },
          "lower_bound": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "title": "Lower Bound",
            "examples": [
              "1240.00"
            ]
          },
          "upper_bound": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Bound"
          },
          "target_price_raw": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Price Raw"
          },
          "target_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Price"
          },
          "applied_constraints": {
            "items": {
              "$ref": "#/components/schemas/ConstraintOut"
            },
            "type": "array",
            "title": "Applied Constraints"
          },
          "recommended_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommended Price"
          },
          "previous_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "examples": [
                  "1240.00"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Price"
          },
          "change_percent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "examples": [
                  "-25.1"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Percent"
          },
          "change_percent_display": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "examples": [
                  "-25.1"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Percent Display"
          },
          "state": {
            "$ref": "#/components/schemas/ResultState"
          },
          "state_label": {
            "type": "string",
            "title": "State Label"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Label"
          },
          "formula": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Formula"
          },
          "confirmation": {
            "$ref": "#/components/schemas/ConfirmationOut"
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "run_status",
          "product",
          "calculated_at",
          "rules_version",
          "partial_data",
          "inputs",
          "accepted_offers",
          "rejected_offers",
          "min_competitor_price",
          "lower_bound",
          "upper_bound",
          "target_price_raw",
          "target_price",
          "applied_constraints",
          "recommended_price",
          "previous_price",
          "change_percent",
          "change_percent_display",
          "state",
          "state_label",
          "reason",
          "reason_label",
          "formula",
          "confirmation"
        ],
        "title": "CalculationOut",
        "description": "Everything behind one price: «Почему цена такая»."
      },
      "ConfirmRefusal": {
        "type": "string",
        "enum": [
          "not_quarantine",
          "already_confirmed",
          "superseded",
          "too_old",
          "purchase_changed",
          "rules_changed",
          "settings_changed",
          "published_changed"
        ],
        "title": "ConfirmRefusal"
      },
      "ConfirmRefusalOut": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ConfirmRefusal"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "title": "ConfirmRefusalOut",
        "description": "409 of a confirmation: the code and its Russian reason."
      },
      "ConfirmationOut": {
        "properties": {
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "confirmed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed At"
          },
          "can_confirm": {
            "type": "boolean",
            "title": "Can Confirm"
          },
          "refusal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfirmRefusal"
              },
              {
                "type": "null"
              }
            ]
          },
          "refusal_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal Label"
          }
        },
        "type": "object",
        "required": [
          "confirmed",
          "confirmed_at",
          "can_confirm",
          "refusal",
          "refusal_label"
        ],
        "title": "ConfirmationOut",
        "description": "Confirmation of a quarantined recommendation (extension 1 of plan.md).\n\n``can_confirm`` says whether POST /api/calculations/{id}/confirm would publish\nnow; otherwise ``refusal`` is the code it would answer with (409) and\n``refusal_label`` its Russian reason, e.g. for a disabled button."
      },
      "Constraint": {
        "type": "string",
        "enum": [
          "lower_bound",
          "ceiling"
        ],
        "title": "Constraint"
      },
      "ConstraintOut": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Constraint"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "title": "ConstraintOut"
      },
      "DemoMode": {
        "type": "string",
        "enum": [
          "normal",
          "markup_changed",
          "unavailable",
          "blocked",
          "price_spike"
        ],
        "title": "DemoMode",
        "description": "Failure modes of the synthetic sources (the same codes as fake-sites)."
      },
      "DemoModesOut": {
        "properties": {
          "modes": {
            "items": {
              "$ref": "#/components/schemas/SourceModeOut"
            },
            "type": "array",
            "title": "Modes"
          }
        },
        "type": "object",
        "required": [
          "modes"
        ],
        "title": "DemoModesOut"
      },
      "DemoResetOut": {
        "properties": {
          "products": {
            "type": "integer",
            "title": "Products"
          },
          "published_prices": {
            "type": "integer",
            "title": "Published Prices"
          },
          "modes": {
            "items": {
              "$ref": "#/components/schemas/SourceModeOut"
            },
            "type": "array",
            "title": "Modes"
          }
        },
        "type": "object",
        "required": [
          "products",
          "published_prices",
          "modes"
        ],
        "title": "DemoResetOut",
        "description": "What the reset did: the database is back to the seed, both sources are normal."
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOut"
      },
