# Normalize all text files to LF in the repository and working tree,
# so scripts and configs copied into Linux containers never carry CRLF.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.env.example text eol=lf

*.png binary
*.jpg binary
*.ico binary
